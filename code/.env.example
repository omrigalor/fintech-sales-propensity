# Copy to .env and paste your LLM provider key (do NOT commit .env).
# Any OpenAI-compatible chat-completions provider works.
LLM_API_KEY=your_key_here
# Optional: override the endpoint (defaults to OpenAI's chat-completions URL).
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# The model ids "reasoning-pro" / "reasoning-flash" are placeholders — map them to
# whatever reasoning-grade and fast models your provider exposes.
